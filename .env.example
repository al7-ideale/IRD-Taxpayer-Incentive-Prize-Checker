# Environment Variables Configuration
# Copy this to .env and update values as needed

# =============================================================================
# API Configuration
# =============================================================================
API_URL=https://prize.ird.gov.np/api/v1/public/winners
API_TIMEOUT=10

# =============================================================================
# OCR Configuration
# =============================================================================
# Use GPU acceleration if available (true/false)
OCR_GPU=false

# Maximum image dimension before downscaling (prevents memory issues)
MAX_IMAGE_DIMENSION=1280

# =============================================================================
# Cache Configuration
# =============================================================================
# Time to live for cached results (seconds)
CACHE_TTL=3600

# =============================================================================
# Streamlit Configuration
# =============================================================================
# Server port
STREAMLIT_SERVER_PORT=8501

# Run in headless mode (for servers)
STREAMLIT_SERVER_HEADLESS=true

# Enable XSRF protection
STREAMLIT_SERVER_ENABLEXSRFPROTECTION=true

# =============================================================================
# Logging Configuration
# =============================================================================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path (optional)
LOG_FILE=logs/app.log
